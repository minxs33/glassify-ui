{
  "name": "@minxs33/glassify-ui",
  "version": "1.0.5",
  "description": "A React component library for creating glassmorphism UI effects.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "demo.gif"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "release:patch": "npm version patch && pnpm build &&  npm publish --access public"
  },
  "keywords": [
    "react",
    "component-library",
    "glassmorphism",
    "ui-components",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3"
  }
}
