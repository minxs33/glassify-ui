{
  "name": "glassify-ui",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "src/util/",
    "src/component/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --watch --dts --onSuccess \"pnpm yalc-push\"",
    "yalc-push": "npx yalc push --changed"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.1.8",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3"
  }
}
